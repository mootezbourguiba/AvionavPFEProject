# Application
APP_NAME=Avionics Health Monitoring
APP_VERSION=1.0.0
DEBUG=True

# Database
DATABASE_URL=sqlite:///./avionics.db

# Security
# SECRET_KEY is MANDATORY. Generate a long random value for local use
# (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
# The backend refuses to start without it. Never commit a real secret.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:8501", "http://localhost:3000"]

# API
API_V1_STR=/api/v1
